# Database Configuration
DATABASE_URL=mssql+pyodbc://sa:Coursework_2026%21@localhost:1433/coursework?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
CORS_ORIGINS=http://localhost:8080

# Storage backend: use local for native development without OSS.
STORAGE_BACKEND=oss
# Enable only for local verification; forbids any OSS client access.
STORAGE_LOCAL_ONLY=false
LOCAL_STORAGE_ROOT=../data/files
LOCAL_STORAGE_SECRET=replace-with-a-random-secret-before-using-local-storage

# OSS Configuration
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=se-lab
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_PREVIEW_URL_TTL_SECONDS=300

# Frontend Configuration
MARKDOWN_MAX_BYTES=5242880
MARKDOWN_IMAGE_MAX_BYTES=10485760
MARKDOWN_IMAGE_MAX_PIXELS=40000000
MARKDOWN_ASSET_ORPHAN_HOURS=24
EXPORT_ARCHIVE_HOURS=24
FRONTEND_DIST=../frontend/dist
SECURE_COOKIES=false

# Shared model endpoint for AI teacher and grading.
# Module-specific endpoint/key/model/timeout variables are no longer used.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_CHAT_MODEL=deepseek-chat
AI_REQUEST_TIMEOUT_SECONDS=60

# Enable each module after configuring the shared endpoint and credentials.
AI_TEACHER_ENABLED=true
AI_TEACHER_MAX_OUTPUT_TOKENS=1600
AI_GRADING_ENABLED=true
AI_GRADING_MAX_OUTPUT_TOKENS=8192
